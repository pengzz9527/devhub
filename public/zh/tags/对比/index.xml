&lt;/h3&gt;&lt;table&gt;
 &lt;thead&gt;
 &lt;tr&gt;
 &lt;th&gt;数据库&lt;/th&gt;
 &lt;th&gt;导入时间&lt;/th&gt;
 &lt;th&gt;文件大小&lt;/th&gt;
 &lt;/tr&gt;
 &lt;/thead&gt;
 &lt;tbody&gt;
 &lt;tr&gt;
 &lt;td&gt;DuckDB&lt;/td&gt;
 &lt;td&gt;2.1s&lt;/td&gt;
 &lt;td&gt;120MB（Parquet）&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;SQLite&lt;/td&gt;
